# Copy to .env.local for development, and set the same values in the Vercel
# dashboard under Settings > Environment Variables for production.
#
# Without these the contact form renders and validates, but cannot send.

# --- Server only. Never prefix these with NEXT_PUBLIC. ---

# EmailJS dashboard > Email Services / Email Templates
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# EmailJS dashboard > Account > General
EMAILJS_PUBLIC_KEY=

# EmailJS dashboard > Account > API Keys.
# "Allow API calls" must be enabled or server-side sending is rejected.
EMAILJS_PRIVATE_KEY=

# Google reCAPTCHA admin console > your site > Settings > reCAPTCHA keys
RECAPTCHA_SECRET_KEY=

# --- Public. These are exposed in the browser bundle by design. ---

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_SITE_URL=https://www.fadydib.com
NEXT_PUBLIC_GA_ID=
